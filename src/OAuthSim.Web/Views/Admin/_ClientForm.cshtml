@model OAuthClient
@inject OAuthSim.Web.Services.TokenService Tokens
<form asp-action="SaveClient" method="post" hx-post="/Admin/SaveClient" class="form">
    <input type="hidden" name="id" value="@Model.Id" />
    <div class="grid-2">
        <label class="label">Display name<input class="input" name="name" value="@Model.Name" placeholder="My application" /></label>
        <label class="label">Client ID<input class="input mono" name="clientId" value="@Model.ClientId" placeholder="Generated if empty" autocomplete="off" /></label>
    </div>
    <label class="label">Client secret<input class="input mono" type="password" name="clientSecret" value="@Model.ClientSecret" placeholder="Generated if empty" autocomplete="new-password" /></label>
    <fieldset class="fs">
        <legend class="eyebrow">Token identity</legend>
        <div class="grid-2">
            <div>
                <label class="label">Issuer override<input class="input mono" type="url" name="issuer" value="@Model.Issuer" placeholder="@Tokens.Issuer" /></label>
                <p class="help">Applies to access and ID tokens. Leave blank to use the local server origin. Custom issuers use the client-specific discovery URL in Integration.</p>
            </div>
            <div>
                <label class="label">Access-token audience override<input class="input mono" name="accessTokenAudience" value="@Model.AccessTokenAudience" placeholder="@(string.IsNullOrEmpty(Model.ClientId) ? "Client ID" : Model.ClientId)" /></label>
                <p class="help">Leave blank to use the Client ID. ID-token audience always remains the Client ID.</p>
            </div>
        </div>
        <p class="help">Edits take effect on save. Existing access tokens with a different issuer or audience will fail simulator validation.</p>
    </fieldset>
    <fieldset class="fs">
        <legend class="eyebrow">Access</legend>
        <div class="checks">
            <label class="checkbox"><input type="checkbox" name="isPublic" value="true" checked="@Model.IsPublic" /><span>Public client (PKCE required)</span></label>
            <label class="checkbox"><input type="checkbox" name="enabled" value="true" checked="@Model.Enabled" /><span>Enabled</span></label>
            <label class="checkbox"><input type="checkbox" name="makeDefault" value="true" /><span>Use as startup default</span></label>
            <label class="checkbox"><input type="checkbox" name="generateSecret" value="true" /><span>Generate a new secret on save</span></label>
        </div>
    </fieldset>
    <fieldset class="fs">
        <legend class="eyebrow">Token introspection</legend>
        <label class="checkbox"><input type="checkbox" name="requireIntrospectionBasicAuthentication" value="true" checked="@Model.RequireIntrospectionBasicAuthentication" /><span>Require Basic authentication for introspection</span></label>
        <input type="hidden" name="requireIntrospectionBasicAuthentication" value="false" />
        <p class="help">When enabled, callers must send Authorization: Basic using this confidential client's ID and secret. When disabled, callers can inspect this client's valid access tokens without credentials; the client is inferred from the validated token.</p>
    </fieldset>
    <fieldset class="fs">
        <legend class="eyebrow">Redirects</legend>
        <div>
            <label class="label">Redirect URIs<textarea class="textarea" name="redirectUris" rows="3" placeholder="http://localhost:3000/callback">@string.Join('\n', Model.RedirectUris)</textarea></label>
            <p class="help">One per line. An empty list accepts the redirect URI from the request; a populated list requires an exact match.</p>
        </div>
        <label class="checkbox"><input type="checkbox" name="relaxRedirects" value="true" checked="@Model.RelaxRedirects" /><span>Allow unregistered HTTP(S) redirect URIs even with a configured list</span></label>
    </fieldset>
    <fieldset class="fs">
        <legend class="eyebrow">Scopes</legend>
        <div>
            <label class="label">Allowed scopes<input class="input mono" name="scopes" value="@string.Join(' ', Model.Scopes)" placeholder="openid profile email offline_access" /></label>
            <p class="help">Space-separated. An empty list accepts request scopes and additions at login. Include openid and offline_access if your application uses them.</p>
        </div>
        <label class="checkbox"><input type="checkbox" name="relaxScopes" value="true" checked="@Model.RelaxScopes" /><span>Allow extra scopes even with a configured list</span></label>
    </fieldset>
    <fieldset class="fs">
        <legend class="eyebrow">Application claims</legend>
        <partial name="_ApplicationClaims" model="Model" />
    </fieldset>
    <div class="form-actions"><button class="button is-primary">Save client</button></div>
</form>
